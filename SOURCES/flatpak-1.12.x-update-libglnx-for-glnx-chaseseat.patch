+  g_assert_cmpint (symlinkat ("/..", baz_dfd, "link1"), ==, 0);
+
+  /* We should not be able to break out of the root! */
+  check_chase (bar_dfd, "./baz/link1", GLNX_CHASE_RESOLVE_IN_ROOT, get_ino (bar_dfd));
+}
