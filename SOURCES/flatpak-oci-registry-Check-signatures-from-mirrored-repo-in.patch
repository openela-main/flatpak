@@ -3334,23 +3335,20 @@ flatpak_pull_from_oci (OstreeRepo            *repo,
   g_autoptr(GVariantBuilder) metadata_builder = g_variant_builder_new (G_VARIANT_TYPE ("a{sv}"));
